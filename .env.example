# Copy to .env (gitignored) and fill in. Nothing here is a real credential.
# compose refuses to start if POSTGRES_PASSWORD is unset.
#
# Generate one rather than typing a word:  openssl rand -hex 16
# Hex also avoids a second problem — compose builds the connection URL by
# string substitution, so a password containing @ : / or # corrupts the URL.
POSTGRES_PASSWORD=change-me
